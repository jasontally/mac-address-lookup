# Manifests must always be revalidated so new deploys are picked up: they map
# to content-hashed files that are replaced on every deploy.
/data/manifest.json
  Cache-Control: no-cache

/data/sources-index.json
  Cache-Control: no-cache

# Content-hashed data and raw source copies are immutable.
/data/*.parquet
  Cache-Control: public, max-age=31536000, immutable

/data/sources/*
  Cache-Control: public, max-age=31536000, immutable

# Bundled app assets are content-hashed; cache them immutably.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Legal pages: they must not be cached hard, because a change to the terms is
# a change a user must be able to see.
/privacy.html
  Cache-Control: public, max-age=86400

/terms.html
  Cache-Control: public, max-age=86400

# Crawler-facing files: robots.txt and the favicon change rarely, so they are
# cached for a week.
#
# The sitemap is NOT one of them. Its bytes change on every data refresh, since
# each URL carries its own lastmod, and a stale sitemap is a sitemap that says
# the wrong thing. It must be no-cache for two reasons.
#
# The first is freshness: Google has to see the current lastmod values, not the
# ones from a week ago.
#
# The second is the SPA fallback. not_found_handling is
# "single-page-application", so a path that does not exist answers with the
# shell as text/html and a 200. A crawler cannot tell that from a real page.
# The shell for a missing sitemap path used to be cached here for a week, so a
# crawler that fetched a chunk path before the build wrote it kept reading
# "Sitemap is HTML" long after the file was there. With no-cache the edge
# revalidates on every read, so a missing path is picked up as soon as the
# file exists, and a bad response cannot stick.
/robots.txt
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/sitemap*
  Cache-Control: no-cache

# Agent-facing documentation and downloads: stable names, refreshed weekly
# with the data, so revalidate daily rather than caching long.
/llms.txt
  Cache-Control: public, max-age=86400

# ARD catalogs, which declare the site's MCP server. Real JSON files here also
# prevent the SPA fallback from turning these well-known paths into HTML.
/.well-known/ai-catalog.json
  Content-Type: application/ai-catalog+json
  Cache-Control: public, max-age=86400

/.well-known/ard.json
  Content-Type: application/ai-catalog+json
  Cache-Control: public, max-age=86400

# OAuth 2.0 Protected Resource Metadata (RFC 9728). The MCP endpoint needs no
# authorization, so the document lists no authorization servers. It exists so an
# auth-discovery probe gets parseable JSON instead of the SPA shell: with
# not_found_handling single-page-application, an unmatched .well-known path
# returns index.html with a 200. Both paths are listed because _redirects maps
# the bare one onto the other, and _headers matches the request path.
/.well-known/oauth-protected-resource
  Content-Type: application/json
  Cache-Control: public, max-age=86400

/.well-known/oauth-protected-resource/mcp
  Content-Type: application/json
  Cache-Control: public, max-age=86400

# MCP server card: the pre-connection discovery document at the path clients
# probe (SEP-1649). It is the same document as server.json, the metadata the
# official MCP Registry publishes, so an agent that finds either one finds the
# same server. A real JSON file here also stops the SPA fallback from answering
# this path with HTML.
/.well-known/mcp/server-card.json
  Content-Type: application/json
  Cache-Control: public, max-age=86400

# Additional discovery documents.
/.well-known/api-catalog
  Content-Type: application/linkset+json
  Cache-Control: public, max-age=86400

/.well-known/agent-card.json
  Content-Type: application/json
  Cache-Control: public, max-age=86400

/.well-known/poppy.json
  Content-Type: application/json
  Cache-Control: public, max-age=86400

/.well-known/openapi.json
  Content-Type: application/json
  Cache-Control: public, max-age=86400

# Agent Skills discovery index and artifacts.
/.well-known/agent-skills/index.json
  Content-Type: application/json
  Cache-Control: public, max-age=86400

/.well-known/agent-skills/lookup/SKILL.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=86400

# help.md carries Markdown source; some tools refuse the text/markdown media
# type, so present it as plain text (the content reads fine either way).
/help.md
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# auth.md: agent registration discovery (Auth.md standard). No auth is required
# for this site or its MCP endpoint, so the document says so explicitly.
/auth.md
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/help.txt
  Cache-Control: public, max-age=86400

/data/registry.ndjson
  Cache-Control: public, max-age=86400

/data/lineage.ndjson
  Cache-Control: public, max-age=86400

# MCP lookup shards: keyed by a registered prefix, so the file name never changes
# when the content does. Scoped to *.txt on purpose. catalog.json sits in the same
# directory and must NOT inherit this: it carries the tool description and the
# protocol versions, it changes when the generator changes, and a 24-hour TTL
# leaves every edge location that cached it serving the old one after a deploy.
# That is what made the endpoint disagree with itself between locations, and why
# a fix could look live in one test and broken in another. catalog.json falls
# through to the platform default, public, max-age=0, must-revalidate.
#
# The shards must stay text/plain. The zone Snippet reads a shard only when the
# content type is text/plain (mcp/snippet.js, readShard), because the SPA
# fallback answers any unmatched path with the shell as text/html. Serving the
# shards as text/html would make every shard unreadable, so every lookup would
# report "no registered prefix" while the endpoint still answered with HTTP 200.
# No Content-Type is set here on purpose: the platform already serves .txt as
# text/plain, and naming it here would only freeze the value.
/data/mcp/*.txt
  Cache-Control: public, max-age=86400

# Agent discovery: Link response headers on the homepage (RFC 8288).
/
  Link: </llms.txt>; rel="describedby", </help>; rel="service-doc", </.well-known/ai-catalog.json>; rel="ai-catalog"

# Security headers (catch-all last so specific cache rules apply first).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
