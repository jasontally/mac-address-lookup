# Manifests must always be revalidated so new deploys are picked up: they map
# to content-hashed files that are replaced on every deploy.
/data/manifest.json
  Cache-Control: no-cache

/data/sources-index.json
  Cache-Control: no-cache

# Content-hashed data and raw source copies are immutable.
/data/*.parquet
  Cache-Control: public, max-age=31536000, immutable

/data/sources/*
  Cache-Control: public, max-age=31536000, immutable

# Bundled app assets are content-hashed; cache them immutably.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Crawler-facing files change rarely; keep them cached for a week.
/favicon.svg
  Cache-Control: public, max-age=604800

/robots.txt
  Cache-Control: public, max-age=604800

/sitemap*
  Cache-Control: public, max-age=604800

# Security headers (catch-all last so specific cache rules apply first).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
