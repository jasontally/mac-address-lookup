{
  "name": "mac-address-lookup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free client-side MAC address lookup — identify the vendor behind any full or partial MAC address or OUI instantly in your browser.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "test": "node --test test/",
    "test:e2e": "playwright test",
    "serve": "node build/serve.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy && node build/indexnow.mjs"
  },
  "dependencies": {
    "hyparquet": "^1.30.1",
    "hyparquet-writer": "^0.16.9"
  },
  "overrides": {
    "hyparquet": "$hyparquet"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "esbuild": "^0.28.1",
    "wrangler": "^4.34.0"
  }
}
