{
  "name": "mac-address-lookup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free client-side MAC address lookup \u2014 identify the vendor behind any full or partial MAC address or OUI instantly in your browser.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:e2e": "playwright test",
    "serve": "node build/serve.mjs",
    "dev": "wrangler dev",
    "mcp:accept": "node build/accept-mcp-snippet.mjs",
    "mcp:deploy": "node build/deploy-mcp-snippet.mjs",
    "mcp:conformance": "node test/mcp-conformance.live.mjs",
    "deploy": "wrangler deploy && node build/indexnow.mjs",
    "deploy:all": "npm run deploy && npm run mcp:deploy",
    "mcp:load": "node test/mcp-load.mjs"
  },
  "dependencies": {
    "hyparquet": "^1.30.1",
    "hyparquet-writer": "^0.16.9"
  },
  "overrides": {
    "hyparquet": "$hyparquet"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "esbuild": "^0.28.1",
    "wrangler": "^4.34.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true
  }
}
